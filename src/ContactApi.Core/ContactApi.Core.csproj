<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cloud-neutral core of the contact API: validation, spam checks, rate limiting and the
    request flow. Knows nothing about Azure or AWS — each cloud host plugs in its own
    IMessageStore (database) and IEmailNotifier (email) implementations.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ContactApi.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
